#include <dt-bindings/zmk/mouse.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define MEDIA 3

#define SL_TO(layer) &sl_to layer layer //tap -> sticky layer, double tap -> to layer

&sl { release-after-ms = <3000>; };

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&bootloader>, <&out OUT_TOG>;
        };
    };

    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mt DLLR SEMI>, <&to SYM>;
        };
    };

    behaviors {
        tdc_to_MEDIA: td_mute_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&kp C_MUTE>, <&to MEDIA>;
        };
    };

    behaviors {
        td1: tap_stickylayer_doubletap_tolayer_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl 1>, <&to 1>;
        };
    };

    behaviors {
        td2: tap_stickylayer_doubletap_tolayer_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl 2>, <&to 2>;
        };
    };

    behaviors {
        sk_kp: behavior_sk_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <400>;
            bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };

        td_r2r: td_r2r {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_R2R";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp LS(R)>;
        };

        td_e2e: td_e2e {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_E2E";
            #binding-cells = <0>;
            bindings = <&kp E>, <&kp LS(E)>;
        };

        td_w2w: td_w2w {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_W2W";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp LS(W)>;
        };

        td_q2q: td_q2q {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q2Q";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp LS(Q)>;
        };

        td_t2t: td_t2t {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_T2T";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp LS(T)>;
        };

        td_o2o: td_o2o {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_O2O";
            #binding-cells = <0>;
            bindings = <&kp O>, <&kp LS(O)>;
        };

        td_p2p: td_p2p {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_P2P";
            #binding-cells = <0>;
            bindings = <&kp P>, <&kp LS(P)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp LANGUAGE_1  &mkp RCLK
&kp CLCK        &kp LGUI   &mkp LCLK           &mt ESC K_BACK  &kp TAB
&td_q2q         &td_w2w    &td_e2e             &td_r2r         &td_t2t   &kp Y        &kp U    &kp I      &td_o2o        &td_p2p
&kp A           &kp S      &kp D               &kp F           &kp G     &kp H        &kp J    &kp K      &kp L          &kp BSPC
&sk LSHFT       &kp Z      &kp X               &kp C           &kp V     &kp B        &kp N    &kp M      &mt DLLR SEMI  &kp ENTER
                           &sk_kp LCTRL LCTRL                  &kp LALT  &kp SPACE    &to SYM  &to UPPER
            >;
        };

        sym_layer {
            bindings = <
&kp C_VOL_UP  &kp C_VOL_DN
&kp PSCRN     &kp C_AC_SEARCH  &mkp LCLK  &kp ESC  &kp F12
&kp HASH      &kp N1           &kp N2     &kp N3   &mt LBKT LPAR  &mt RBKT RPAR    &kp UNDER    &kp MINUS  &kp PLUS       &kp AT
&kp STAR      &kp N4           &kp N5     &kp N6   &kp SLASH      &kp COLON        &kp SEMI     &kp APOS   &kp DQT        &kp DEL
&kp LSHFT     &kp N7           &kp N8     &kp N9   &kp QMARK      &kp EXCL         &kp COMMA    &kp DOT    &tdc_to_MEDIA  &kp ENTER
                               &kp LCTRL           &kp N0         &kp SPACE        &to DEFAULT  &to UPPER
            >;
        };

        upper_layer {
            bindings = <
&msc SCRL_UP  &msc SCRL_DOWN
&kp CAPS      &kp LEFT_WIN    &td0       &mt ESC K_BACK  &kp TAB
&none         &kp UP          &none      &sys_reset      &ext_power EP_TOG  &kp TILDE     &kp LT           &kp GT       &kp PIPE      &kp KP_EQUAL
&kp LEFT      &kp DOWN        &kp RIGHT  &none           &kp BSLH           &kp AMPS      &kp LBRC         &kp RBRC     &kp CARET     &kp BSPC
&kp LSHFT     &none           &none      &none           &none              &bl BL_DEC    &rgb_ug RGB_TOG  &bl BL_INC   &td_boot_out  &kp ENTER
                              &kp LCTRL                  &kp LALT           &kp SPACE     &to SYM          &to DEFAULT
            >;
        };

        media_layer {
            bindings = <
&none  &none
&none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none        &none        &none        &none
&none  &none  &none  &none  &none  &none    &none        &none        &none        &none
&none  &none  &none  &none  &none  &none    &none        &none        &to DEFAULT  &none
              &none         &none  &none    &to DEFAULT  &to DEFAULT
            >;
        };
    };
};
